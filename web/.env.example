# Neon (production) or local Docker from docker-compose.yml.
# In production use the POOLED Neon connection string (host contains "-pooler").
DATABASE_URL=postgres://kadr:kadr@localhost:5432/kadr

# Session signing. REQUIRED in production (16+ chars), the app refuses to run without it.
# Generate: openssl rand -base64 48
AUTH_SECRET=kadr-dev-secret-change-me

# Demo login (public admin "andrew"). Off in production unless set to 1.
# ALLOW_DEMO_LOGIN=0

# Emergency switch: close sign-ups without a deploy of code (set to 1).
# REGISTRATION_DISABLED=0

# Bot protection for sign-up (Cloudflare Turnstile). Both keys enable it; empty = off.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret for /api/cron/* (Vercel Cron sends it as "Authorization: Bearer ...").
# CRON_SECRET=

# Per-user file quota in MB (default 1024).
# USER_STORAGE_QUOTA_MB=1024

# Object storage. Preferred: Vercel Blob store `kadr-files`.
# Create with `npx vercel blob create-store kadr-files --access public --region iad1`
# then `npx vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Fallback: MinIO via `npm run storage:up` then `npm run storage:ensure`,
# or Cloudflare R2 (same S3 API) in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=kadr
S3_SECRET_ACCESS_KEY=kadrfiles1
S3_BUCKET=kadr-files
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/kadr-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1

# Cloudflare R2 in production (overrides S3_* if you switch the endpoint)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kadr-files
# R2_PUBLIC_BASE_URL=
