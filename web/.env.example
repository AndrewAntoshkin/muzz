# Neon (production) or local Docker from docker-compose.yml
DATABASE_URL=postgres://kadr:kadr@localhost:5432/kadr

# Session signing (any long random string in production)
AUTH_SECRET=kadr-dev-secret-change-me

# Object storage. Preferred: Vercel Blob store `kadr-files`.
# Create with `npx vercel blob create-store kadr-files --access public --region iad1`
# then `npx vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Fallback: MinIO via `npm run storage:up` then `npm run storage:ensure`,
# or Cloudflare R2 (same S3 API) in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=kadr
S3_SECRET_ACCESS_KEY=kadrfiles1
S3_BUCKET=kadr-files
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/kadr-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1

# Cloudflare R2 in production (overrides S3_* if you switch the endpoint)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kadr-files
# R2_PUBLIC_BASE_URL=
